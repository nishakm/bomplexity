# Copy to .env (git-ignored) and set a password. `make secret` turns this
# file into the db-credentials Secret. Both keys are required.
# The password in DATABASE_URL must match POSTGRES_PASSWORD. "postgres" is the
# in-cluster Service name of the database.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://guestbook:change-me@postgres:5432/guestbook?sslmode=disable
